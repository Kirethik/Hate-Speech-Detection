# Copy to .env and fill in. Every CIVITAS_* setting is documented in voice/settings.py.

# Hugging Face token: needed for the gated models (IndicF5, IndicConformer).
# 1) log in at huggingface.co  2) open both model pages and click "Agree"  3) create a read token
HF_TOKEN=

# --- ASR (runs on the CPU; int8 is fast on Core Ultra) ---
CIVITAS_WHISPER_MODEL=large-v3-turbo
CIVITAS_WHISPER_COMPUTE=int8
CIVITAS_ENABLE_INDIC_ASR=true

# --- classifiers: auto = Intel XPU if PyTorch sees it, else CPU ---
CIVITAS_DETECTOR_DEVICE=auto

# --- LLM (Ollama by default; any OpenAI-compatible server works) ---
CIVITAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
CIVITAS_LLM_MODEL=gemma4:e4b
CIVITAS_LLM_GATE=0.30
# "none" disables hidden thinking (gemma4 is ~4x slower with it on). Empty = server default.
CIVITAS_LLM_REASONING_EFFORT=none

# --- TTS services started by scripts/run_dev.ps1 ---
CIVITAS_TTS_ROUTES=indicf5=http://127.0.0.1:9001,chatterbox=http://127.0.0.1:9002
CIVITAS_TTS_DEVICE=auto

# --- server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CIVITAS_MAX_AUDIO_S=300
# load ASR + classifiers at startup instead of on the first upload
CIVITAS_WARMUP=1
